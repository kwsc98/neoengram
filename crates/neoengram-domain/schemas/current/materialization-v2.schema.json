                }
              },
              "additionalProperties": false,
              "required": [
                "receipt",
                "target"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "event",
            "payload"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "failed"
            },
            "payload": {
              "description": "No extension members are accepted by the current protocol.",
              "type": "object",
