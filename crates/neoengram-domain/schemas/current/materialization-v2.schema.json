    "MaterializationReport": {
      "description": "Agent-to-Central object-level report for a materialization batch.\n\nReceipts are emitted only after the target backend has completed its durability barrier.  A\nfailed report is advisory and never creates a Placement; Central keeps the batch retryable.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "receipt"
            },
            "payload": {
              "description": "No extension members are accepted by the current protocol.",
              "type": "object",
              "properties": {
                "receipt": {
                  "$ref": "#/$defs/MaterializationObjectReceipt"
                },
                "target": {
                  "description": "The target fence copied from the signed batch ticket.  Keeping it on every report\nmakes a delayed receipt/failure self-describing; Central still compares it with the\ndurable Batch and the authenticated session/route before applying the report.",
