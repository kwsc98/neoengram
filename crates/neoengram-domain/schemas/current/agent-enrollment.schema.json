{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentEnrollmentEnvelope",
  "description": "Transport-neutral envelope used by a future bootstrap/admin adapter.",
  "type": "object",
  "properties": {
    "wire_version": {
      "$ref": "#/$defs/ProtocolVersion",
      "const": 1
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/AgentEnrollmentTokenCreateRequest"
        },
        "type": {
          "type": "string",
          "const": "agent.enrollment.token.create"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/AgentBootstrapRequest"
        },
        "type": {
          "type": "string",
          "const": "agent.bootstrap"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/AgentBootstrapAccepted"
        },
        "type": {
          "type": "string",
          "const": "agent.bootstrap.accepted"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/AgentBootstrapStatusRequest"
        },
        "type": {
          "type": "string",
          "const": "agent.bootstrap.status.request"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/AgentBootstrapStatusResponse"
        },
        "type": {
          "type": "string",
          "const": "agent.bootstrap.status.response"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/AgentEnrollmentApprovalRequest"
        },
        "type": {
          "type": "string",
          "const": "agent.enrollment.approval"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/AgentMountStatusReport"
        },
        "type": {
          "type": "string",
          "const": "agent.mount.status"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    }
  ],
  "required": [
    "wire_version"
  ],
  "$defs": {
    "AgentBootId": {
      "description": "A validated agent boot ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "AgentBootstrapAccepted": {
      "description": "Stable identity returned after a valid, idempotent bootstrap.",
      "type": "object",
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/AgentId"
        },
        "agent_mount_id": {
          "$ref": "#/$defs/AgentMountId"
        },
        "bootstrap_request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "enrollment_id": {
          "$ref": "#/$defs/AgentEnrollmentId"
        },
        "mount_generation": {
          "$ref": "#/$defs/MountGeneration"
        },
        "replayed": {
          "type": "boolean"
        },
        "resource_version": {
          "$ref": "#/$defs/ResourceVersion"
        },
        "review_expires_at_unix_ms": {
          "$ref": "#/$defs/UnixMillis"
        },
        "state": {
          "$ref": "#/$defs/AgentEnrollmentState"
        }
      },
      "required": [
        "bootstrap_request_id",
        "enrollment_id",
        "agent_id",
        "agent_mount_id",
        "state",
        "mount_generation",
        "resource_version",
        "review_expires_at_unix_ms",
        "replayed"
      ]
    },
    "AgentBootstrapProbe": {
      "description": "Bootstrap-time evidence that can be projected into a public enrollment summary.",
      "type": "object",
      "properties": {
        "access_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/MountAccessMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "fsync_supported": {
          "type": "boolean"
        },
        "health": {
          "$ref": "#/$defs/ResourceHealth"
        },
        "marker_matches": {
          "type": "boolean"
        },
        "mount_boundary_detected": {
          "type": "boolean"
        },
        "mount_identity_digest": {
          "$ref": "#/$defs/AgentMountIdentityDigest"
        },
        "observed_at_unix_ms": {
          "$ref": "#/$defs/UnixMillis"
        },
        "observed_volume_marker": {
          "description": "Internal opaque marker value used by the center to verify `marker_matches`.",
          "anyOf": [
            {
              "$ref": "#/$defs/VolumeMarkerId"
            },
            {
              "type": "null"
            }
          ]
        },
        "rename_supported": {
          "type": "boolean"
        }
      },
      "required": [
        "marker_matches",
        "mount_boundary_detected",
        "mount_identity_digest",
        "rename_supported",
        "fsync_supported",
        "health",
        "observed_at_unix_ms"
      ]
    },
    "AgentBootstrapProof": {
      "description": "Proof that a bootstrap or status caller controls the private key matching its SPKI.",
      "type": "object",
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/AgentSignatureAlgorithm"
        },
        "public_key_spki": {
          "$ref": "#/$defs/Ed25519PublicKeySpki"
        },
        "signature": {
          "$ref": "#/$defs/Ed25519Signature"
        }
      },
      "required": [
        "algorithm",
        "public_key_spki",
        "signature"
      ]
    },
    "AgentBootstrapRequest": {
      "description": "First Agent contact. The opaque token resolves all Tenant and Volume scope centrally.",
      "type": "object",
      "properties": {
        "agent_version": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "bootstrap_request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "bootstrap_token": {
          "type": "string",
          "maxLength": 2048,
          "minLength": 32
        },
        "capabilities": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "edge_cluster_id": {
          "$ref": "#/$defs/EdgeClusterId"
        },
        "installation_id": {
          "$ref": "#/$defs/AgentInstallationId"
        },
        "probe": {
          "description": "Sanitized mount evidence. Raw paths, filesystem IDs, and mount sources stay Agent-local.",
          "$ref": "#/$defs/AgentBootstrapProbe"
        },
        "proof": {
          "$ref": "#/$defs/AgentBootstrapProof"
        },
        "public_key_fingerprint": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "storage_volume_id": {
          "$ref": "#/$defs/StorageVolumeId"
        },
        "tenant_id": {
          "$ref": "#/$defs/TenantId"
        },
        "volume_descriptor_digest": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "wire_version": {
          "$ref": "#/$defs/ProtocolVersion",
          "const": 1
        }
      },
      "required": [
        "bootstrap_request_id",
        "bootstrap_token",
        "installation_id",
        "tenant_id",
        "edge_cluster_id",
        "storage_volume_id",
        "volume_descriptor_digest",
        "agent_version",
        "wire_version",
        "public_key_fingerprint",
        "proof",
        "probe"
      ]
    },
    "AgentBootstrapStatusRequest": {
      "description": "Signed polling request used before an approved Agent has a long-lived credential.",
      "type": "object",
      "properties": {
        "bootstrap_request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "installation_id": {
          "$ref": "#/$defs/AgentInstallationId"
        },
        "proof": {
          "$ref": "#/$defs/AgentBootstrapProof"
        },
        "signed_at_unix_ms": {
          "$ref": "#/$defs/UnixMillis"
        },
        "tenant_id": {
          "$ref": "#/$defs/TenantId"
        },
        "wire_version": {
          "$ref": "#/$defs/ProtocolVersion",
          "const": 1
        }
      },
      "required": [
        "wire_version",
        "tenant_id",
        "bootstrap_request_id",
        "installation_id",
        "signed_at_unix_ms",
        "proof"
      ]
    },
    "AgentBootstrapStatusResponse": {
      "description": "Poll result for one stable bootstrap request identity.",
      "type": "object",
      "properties": {
        "agent_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "bootstrap_request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "certificate": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentWorkloadCertificateBundle"
            },
            {
              "type": "null"
            }
          ]
        },
        "enrollment_id": {
          "$ref": "#/$defs/AgentEnrollmentId"
        },
        "installation_id": {
          "$ref": "#/$defs/AgentInstallationId"
        },
        "resource_version": {
          "$ref": "#/$defs/ResourceVersion"
        },
        "state": {
          "$ref": "#/$defs/AgentBootstrapStatusState"
        },
        "updated_at_unix_ms": {
          "$ref": "#/$defs/UnixMillis"
        },
        "wire_version": {
          "$ref": "#/$defs/ProtocolVersion",
          "const": 1
        }
      },
      "required": [
        "wire_version",
        "bootstrap_request_id",
        "installation_id",
        "state",
        "enrollment_id",
        "resource_version",
        "updated_at_unix_ms"
      ]
    },
    "AgentBootstrapStatusState": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired"
      ]
    },
    "AgentEnrollmentApprovalRequest": {
      "description": "Tenant-admin decision; the authenticated actor is supplied by the future adapter.",
      "type": "object",
      "properties": {
        "confirm_replacement": {
          "type": "boolean"
        },
        "decision": {
          "$ref": "#/$defs/AgentEnrollmentDecision"
        },
        "decision_request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "enrollment_id": {
          "$ref": "#/$defs/AgentEnrollmentId"
        },
        "expected_resource_version": {
          "$ref": "#/$defs/ResourceVersion"
        }
      },
      "required": [
        "enrollment_id",
        "decision_request_id",
        "expected_resource_version",
        "decision",
        "confirm_replacement"
      ]
    },
    "AgentEnrollmentDecision": {
      "type": "string",
      "enum": [
        "approve",
        "reject"
      ]
    },
    "AgentEnrollmentId": {
      "description": "A validated agent enrollment ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "AgentEnrollmentState": {
      "type": "string",
      "enum": [
        "token_issued",
        "pending_approval",
        "approved",
        "rejected",
        "expired",
        "revoked"
      ]
    },
    "AgentEnrollmentTokenCreateRequest": {
      "description": "Platform-created token intent. Reserved IDs are central-owned and never chosen by an Agent.",
      "type": "object",
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/AgentId"
        },
        "agent_mount_id": {
          "$ref": "#/$defs/AgentMountId"
        },
        "bootstrap_token": {
          "type": "string",
          "maxLength": 2048,
          "minLength": 32
        },
        "created_at_unix_ms": {
          "$ref": "#/$defs/UnixMillis"
        },
        "desired_access_mode": {
          "$ref": "#/$defs/MountAccessMode"
        },
        "edge_cluster_id": {
          "$ref": "#/$defs/EdgeClusterId"
        },
        "enrollment_id": {
          "$ref": "#/$defs/AgentEnrollmentId"
        },
        "expected_volume_marker": {
          "$ref": "#/$defs/VolumeMarkerId"
        },
        "expires_at_unix_ms": {
          "$ref": "#/$defs/UnixMillis"
        },
        "pvc_identity_digest": {
          "$ref": "#/$defs/PvcIdentityDigest"
        },
        "storage_volume_id": {
          "$ref": "#/$defs/StorageVolumeId"
        },
        "tenant_id": {
          "$ref": "#/$defs/TenantId"
        },
        "token_id": {
          "$ref": "#/$defs/AgentEnrollmentTokenId"
        },
        "token_request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "volume_descriptor_digest": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "token_id",
        "token_request_id",
        "enrollment_id",
        "tenant_id",
        "edge_cluster_id",
        "storage_volume_id",
        "volume_descriptor_digest",
        "pvc_identity_digest",
        "agent_id",
        "agent_mount_id",
        "expected_volume_marker",
        "desired_access_mode",
        "bootstrap_token",
        "created_at_unix_ms",
        "expires_at_unix_ms"
      ]
    },
    "AgentEnrollmentTokenId": {
      "description": "A validated agent enrollment token ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "AgentId": {
      "description": "A validated agent ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "AgentInstallationId": {
      "description": "A validated agent installation ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "AgentMountId": {
      "description": "A validated agent mount ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "AgentMountIdentityDigest": {
      "description": "Opaque identity of the filesystem mounted by one volume-scoped Agent.\n\nRaw mount sources and filesystem identifiers never cross the Agent boundary. The stable digest\nis bound during bootstrap and checked on every mount status report.",
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "AgentMountStatusReport": {
      "description": "Mount observation submitted on an already-open, center-issued session generation.",
      "type": "object",
      "properties": {
        "access_mode": {
          "$ref": "#/$defs/MountAccessMode"
        },
        "agent_id": {
          "$ref": "#/$defs/AgentId"
        },
        "agent_mount_id": {
          "$ref": "#/$defs/AgentMountId"
        },
        "available_bytes": {
          "description": "Bytes currently available to staging and CAS publication on this exact mounted Volume.",
          "$ref": "#/$defs/DecimalU64"
        },
        "boot_id": {
          "$ref": "#/$defs/AgentBootId"
        },
        "health": {
          "$ref": "#/$defs/ResourceHealth"
        },
        "installation_id": {
          "$ref": "#/$defs/AgentInstallationId"
        },
        "mount_generation": {
          "$ref": "#/$defs/MountGeneration"
        },
        "mount_identity_digest": {
          "$ref": "#/$defs/AgentMountIdentityDigest"
        },
        "observed_at_unix_ms": {
          "$ref": "#/$defs/UnixMillis"
        },
        "observed_volume_marker": {
          "$ref": "#/$defs/VolumeMarkerId"
        },
        "owner_generation": {
          "$ref": "#/$defs/OwnerGeneration"
        },
        "sequence": {
          "$ref": "#/$defs/SequenceNumber"
        },
        "session_generation": {
          "$ref": "#/$defs/SessionGeneration"
        },
        "storage_volume_id": {
          "$ref": "#/$defs/StorageVolumeId"
        }
      },
      "required": [
        "agent_id",
        "installation_id",
        "boot_id",
        "session_generation",
        "sequence",
        "agent_mount_id",
        "storage_volume_id",
        "mount_generation",
        "owner_generation",
        "observed_volume_marker",
        "mount_identity_digest",
        "access_mode",
        "health",
        "available_bytes",
        "observed_at_unix_ms"
      ]
    },
    "AgentSignatureAlgorithm": {
      "description": "Signature suite admitted for bootstrap proof of possession.",
      "type": "string",
      "enum": [
        "ed25519"
      ]
    },
    "AgentWorkloadCertificateBundle": {
      "description": "Versioned, Central-issued Agent mTLS credential delivered with approved enrollment status.\n\nThe identity URI and all generation fields are signed by the enclosing HTTPS/mTLS channel and\nare checked against the Agent's configured cluster and persisted Ed25519 public key before the\ncertificate is installed. Certificate bytes are public material; the private key never leaves\nthe Agent's durable identity store.",
      "type": "object",
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/AgentId"
        },
        "certificate_bundle_version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "certificate_generation": {
          "$ref": "#/$defs/CertificateGeneration"
        },
        "edge_cluster_id": {
          "$ref": "#/$defs/EdgeClusterId"
        },
        "enrollment_id": {
          "$ref": "#/$defs/AgentEnrollmentId"
        },
        "identity_uri": {
          "type": "string",
          "maxLength": 512,
          "minLength": 1
        },
        "issuer_chain_der": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentWorkloadCertificateDer"
          }
        },
        "leaf_certificate_der": {
          "$ref": "#/$defs/AgentWorkloadCertificateDer"
        },
        "mount_generation": {
          "$ref": "#/$defs/MountGeneration"
        },
        "not_after_unix_ms": {
          "$ref": "#/$defs/UnixMillis"
        },
        "not_before_unix_ms": {
          "$ref": "#/$defs/UnixMillis"
        },
        "owner_generation": {
          "$ref": "#/$defs/OwnerGeneration"
        },
        "public_key_fingerprint": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "renew_at_unix_ms": {
          "$ref": "#/$defs/UnixMillis"
        },
        "session_generation": {
          "$ref": "#/$defs/SessionGeneration"
        }
      },
      "required": [
        "certificate_bundle_version",
        "edge_cluster_id",
        "agent_id",
        "enrollment_id",
        "identity_uri",
        "public_key_fingerprint",
        "certificate_generation",
        "session_generation",
        "mount_generation",
        "owner_generation",
        "not_before_unix_ms",
        "not_after_unix_ms",
        "renew_at_unix_ms",
        "leaf_certificate_der",
        "issuer_chain_der"
      ]
    },
    "AgentWorkloadCertificateDer": {
      "description": "Bounded DER bytes transported in an Agent workload certificate bundle.\n\nThe wire form is canonical unpadded base64url. Keeping this wrapper separate from the much\nlarger Gateway opaque-payload type prevents an enrollment response from being used as an\nunbounded data channel.",
      "type": "string",
      "maxLength": 87382,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "CertificateGeneration": {
      "description": "A certificate generation encoded as a canonical decimal JSON string.",
      "type": "string",
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^([1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"
    },
    "DecimalU64": {
      "description": "A unsigned integer encoded as a canonical decimal JSON string.",
      "type": "string",
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"
    },
    "Ed25519PublicKeySpki": {
      "description": "Canonical RFC 8410 Ed25519 SubjectPublicKeyInfo DER, encoded as base64url without padding.",
      "type": "string",
      "maxLength": 59,
      "minLength": 59,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "Ed25519Signature": {
      "description": "Canonical 64-byte Ed25519 signature, encoded as base64url without padding.",
      "type": "string",
      "maxLength": 86,
      "minLength": 86,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "EdgeClusterId": {
      "description": "A validated edge cluster ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "MountAccessMode": {
      "type": "string",
      "enum": [
        "read_only",
        "read_write"
      ]
    },
    "MountGeneration": {
      "description": "A mount generation encoded as a canonical decimal JSON string.",
      "type": "string",
      "maxLength": 20,
      "minLength": 1,
