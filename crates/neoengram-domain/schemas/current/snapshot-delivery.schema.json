{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SnapshotDeliveryAssignment",
  "description": "Complete placement/fencing data required by an Agent to materialize a Delivery.",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/SnapshotDeliveryAction"
    },
    "agent_id": {
      "$ref": "#/$defs/AgentId"
    },
    "agent_mount_id": {
      "$ref": "#/$defs/AgentMountId"
    },
    "artifact_id": {
      "$ref": "#/$defs/ArtifactId"
    },
    "assignment_generation": {
      "$ref": "#/$defs/AssignmentGeneration"
    },
    "assignment_id": {
      "$ref": "#/$defs/AssignmentId"
    },
    "commit_id": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "copy_reserve_bytes": {
      "$ref": "#/$defs/DecimalU64"
    },
    "deadline_unix_ms": {
      "$ref": "#/$defs/UnixMillis"
    },
    "delivery_generation": {
      "$ref": "#/$defs/DeliveryGeneration"
    },
    "delivery_id": {
      "$ref": "#/$defs/SnapshotDeliveryId"
    },
    "hardlink_policy": {
      "$ref": "#/$defs/HardlinkPolicy"
    },
    "job_id": {
      "$ref": "#/$defs/JobId"
    },
    "mode": {
      "$ref": "#/$defs/SnapshotDeliveryMode"
    },
    "mount_generation": {
      "$ref": "#/$defs/MountGeneration"
    },
    "owner_generation": {
      "$ref": "#/$defs/OwnerGeneration"
    },
    "placement_generation": {
      "$ref": "#/$defs/PlacementGeneration"
    },
    "principal": {
      "$ref": "#/$defs/PrincipalRef"
    },
    "project_id": {
      "$ref": "#/$defs/ProjectId"
    },
    "request_digest": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot_id": {
      "$ref": "#/$defs/SnapshotId"
    },
    "snapshot_size_bytes": {
      "$ref": "#/$defs/DecimalU64"
    },
    "source_index_digest": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "storage_volume_id": {
      "$ref": "#/$defs/StorageVolumeId"
    },
    "target_relative_root": {
      "type": "string"
    },
    "tenant_id": {
      "$ref": "#/$defs/TenantId"
    }
  },
  "required": [
    "job_id",
    "assignment_id",
    "assignment_generation",
    "agent_id",
    "principal",
    "action",
    "tenant_id",
    "project_id",
    "artifact_id",
    "snapshot_id",
    "delivery_id",
    "commit_id",
    "storage_volume_id",
    "snapshot_size_bytes",
    "copy_reserve_bytes",
    "hardlink_policy",
    "agent_mount_id",
    "mount_generation",
    "owner_generation",
    "placement_generation",
    "mode",
    "target_relative_root",
    "source_index_digest",
    "request_digest",
    "delivery_generation",
    "deadline_unix_ms"
  ],
  "$defs": {
    "AgentId": {
      "description": "A validated agent ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "AgentMountId": {
      "description": "A validated agent mount ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "ArtifactId": {
      "description": "A validated artifact ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "AssignmentGeneration": {
      "description": "A assignment generation encoded as a canonical decimal JSON string.",
      "type": "string",
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^([1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"
