      "description": "A validated assignment ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "DecimalU64": {
      "description": "A unsigned integer encoded as a canonical decimal JSON string.",
      "type": "string",
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"
    },
    "DeliveryGeneration": {
      "description": "A delivery generation encoded as a canonical decimal JSON string.",
      "type": "string",
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^([1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"
    },
    "HardlinkPolicy": {
      "type": "string",
      "enum": [
        "disabled",
        "sealed_acl",
        "trusted_local"
      ]
    },
    "JobId": {
      "description": "A validated job ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "MountGeneration": {
      "description": "A mount generation encoded as a canonical decimal JSON string.",
      "type": "string",
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^([1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"
    },
    "OwnerGeneration": {
      "description": "A owner generation encoded as a canonical decimal JSON string.",
      "type": "string",
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^([1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"
    },
    "PlacementGeneration": {
      "description": "A placement generation encoded as a canonical decimal JSON string.",
      "type": "string",
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^([1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"
    },
    "PrincipalId": {
      "description": "A validated principal ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "PrincipalKind": {
      "type": "string",
      "enum": [
        "user",
        "service",
        "system"
      ]
    },
    "PrincipalRef": {
      "description": "No extension members are accepted by the current protocol.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/PrincipalId"
        },
        "kind": {
          "$ref": "#/$defs/PrincipalKind"
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "ProjectId": {
      "description": "A validated project ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "SnapshotDeliveryAction": {
      "type": "string",
      "enum": [
        "materialize",
        "delete"
      ]
    },
    "SnapshotDeliveryId": {
      "description": "A validated Snapshot delivery ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "SnapshotDeliveryMode": {
      "description": "The physical strategy used to expose one immutable Snapshot.",
      "type": "string",
      "enum": [
        "fuse",
        "copy",
        "hardlink"
      ]
    },
    "SnapshotId": {
      "description": "A validated snapshot ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "StorageVolumeId": {
      "description": "A validated storage volume ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "TenantId": {
      "description": "A validated tenant ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "UnixMillis": {
      "description": "A Unix millisecond timestamp encoded as a canonical decimal JSON string.",
      "type": "string",
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"
    }
  }
}
