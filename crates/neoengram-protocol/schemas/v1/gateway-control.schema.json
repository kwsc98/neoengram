{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatewayControlFrame",
  "description": "One hop-authenticated frame between Central and a Gateway Replica or between two Replicas.",
  "type": "object",
  "properties": {
    "connection_id": {
      "$ref": "#/$defs/GatewayConnectionId"
    },
    "deadline_unix_ms": {
      "$ref": "#/$defs/UnixMillis"
    },
    "gateway_pool_id": {
      "$ref": "#/$defs/GatewayPoolId"
    },
    "gateway_replica_id": {
      "$ref": "#/$defs/GatewayReplicaId"
    },
    "hop_count": {
      "type": "integer",
      "format": "uint8",
      "maximum": 1,
      "minimum": 0
    },
    "protocol_version": {
      "$ref": "#/$defs/ProtocolVersion",
      "const": 1
    },
    "request_id": {
      "$ref": "#/$defs/RequestId"
    },
    "sent_at_unix_ms": {
      "$ref": "#/$defs/UnixMillis"
    },
    "sequence": {
      "$ref": "#/$defs/SequenceNumber"
    },
    "trace_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/TraceId"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/GatewayReplicaHello"
        },
        "type": {
          "type": "string",
          "const": "replica_hello"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/GatewayReplicaHeartbeat"
        },
        "type": {
          "type": "string",
          "const": "replica_heartbeat"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/GatewayPeerDirectory"
        },
        "type": {
          "type": "string",
          "const": "peer_directory"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/GatewayDrain"
        },
        "type": {
          "type": "string",
          "const": "drain"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/GatewayAgentRequest"
        },
        "type": {
          "type": "string",
          "const": "agent_request"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/GatewayAgentResponse"
        },
        "type": {
          "type": "string",
          "const": "agent_response"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/GatewayAgentStreamOpen"
        },
        "type": {
          "type": "string",
          "const": "agent_stream_open"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/GatewayAgentStreamData"
        },
        "type": {
          "type": "string",
          "const": "agent_stream_data"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/GatewayAgentStreamEnd"
        },
        "type": {
          "type": "string",
          "const": "agent_stream_end"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/GatewayRouteLeaseRequest"
        },
        "type": {
          "type": "string",
          "const": "route_acquire"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/GatewayRouteLeaseRequest"
        },
        "type": {
          "type": "string",
          "const": "route_renew"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/GatewayRouteLeaseRequest"
        },
        "type": {
          "type": "string",
          "const": "route_release"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/GatewayRouteLeaseGranted"
        },
        "type": {
          "type": "string",
          "const": "route_granted"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/GatewayRouteFence"
        },
        "type": {
          "type": "string",
          "const": "route_fence"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/GatewayPeerForwardRequest"
        },
        "type": {
          "type": "string",
          "const": "peer_forward"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/GatewayPeerForwardAccepted"
        },
        "type": {
          "type": "string",
          "const": "peer_forward_accepted"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/GatewayBackpressure"
        },
        "type": {
          "type": "string",
          "const": "backpressure"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/GatewayControlError"
        },
        "type": {
          "type": "string",
          "const": "error"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    }
  ],
  "required": [
    "protocol_version",
    "gateway_pool_id",
    "gateway_replica_id",
    "connection_id",
    "sequence",
    "request_id",
    "sent_at_unix_ms",
    "deadline_unix_ms",
    "hop_count"
  ],
  "unevaluatedProperties": true,
  "$defs": {
    "AgentId": {
      "description": "A validated agent ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "CertificateGeneration": {
      "description": "A certificate generation encoded as a canonical decimal JSON string.",
      "type": "string",
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^([1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"
    },
    "EdgeClusterId": {
      "description": "A validated edge cluster ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "GatewayAgentAction": {
      "type": "string",
      "enum": [
        "enrollment_bootstrap",
        "enrollment_status_query",
        "session_open",
        "session_channel_open",
        "session_heartbeat_report",
        "session_message_list_query",
        "job_report_create",
        "job_metadata_batch_stage",
        "job_metadata_page_stage",
        "job_index_page_query",
        "job_manifest_page_query",
        "session_close"
      ]
    },
    "GatewayAgentRequest": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/GatewayAgentAction"
        },
        "body": {
          "$ref": "#/$defs/GatewayOpaqueBytes"
        },
        "stream_id": {
          "$ref": "#/$defs/GatewayConnectionId"
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "stream_id",
        "body"
      ]
    },
    "GatewayAgentResponse": {
      "type": "object",
      "properties": {
        "body": {
          "$ref": "#/$defs/GatewayOpaqueBytes"
        },
        "content_type": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "retry_after_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "type": "integer",
          "format": "uint16",
          "maximum": 599,
          "minimum": 100
        },
        "stream_id": {
          "$ref": "#/$defs/GatewayConnectionId"
        }
      },
      "additionalProperties": false,
      "required": [
        "stream_id",
        "status",
        "content_type",
        "body"
      ]
    },
    "GatewayAgentStreamData": {
      "type": "object",
      "properties": {
        "chunk": {
          "type": "string",
          "maxLength": 349526,
          "minLength": 0,
          "pattern": "^[A-Za-z0-9_-]*$"
        },
        "stream_id": {
          "$ref": "#/$defs/GatewayConnectionId"
        }
      },
      "additionalProperties": false,
      "required": [
        "stream_id",
        "chunk"
      ]
    },
    "GatewayAgentStreamEnd": {
      "type": "object",
      "properties": {
        "stream_id": {
          "$ref": "#/$defs/GatewayConnectionId"
        }
      },
      "additionalProperties": false,
      "required": [
        "stream_id"
      ]
    },
    "GatewayAgentStreamOpen": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/GatewayAgentAction"
        },
        "stream_id": {
          "$ref": "#/$defs/GatewayConnectionId"
        }
      },
      "additionalProperties": false,
      "required": [
        "stream_id",
        "action"
      ]
    },
    "GatewayBackpressure": {
      "type": "object",
      "properties": {
        "retry_after_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "retry_after_ms"
      ]
    },
    "GatewayConnectionId": {
      "description": "A validated gateway connection ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "GatewayControlError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/GatewayErrorCode"
        },
        "detail": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "detail",
        "retryable"
      ]
    },
    "GatewayDrain": {
      "type": "object",
      "properties": {
        "deadline_unix_ms": {
          "$ref": "#/$defs/UnixMillis"
        },
        "reason": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "deadline_unix_ms",
        "reason"
      ]
    },
    "GatewayErrorCode": {
      "type": "string",
      "enum": [
        "protocol_invalid",
        "identity_rejected",
        "route_unavailable",
        "route_fenced",
        "deadline_exceeded",
        "resource_exhausted",
        "internal"
      ]
    },
    "GatewayOpaqueBytes": {
      "description": "Opaque bytes encoded as canonical base64url without padding.",
      "type": "string",
      "maxLength": 12582912,
      "minLength": 0,
      "pattern": "^[A-Za-z0-9_-]*$"
    },
    "GatewayPeerDirectory": {
      "description": "Versioned, bounded and short-lived peer credential directory delivered by Central.",
      "type": "object",
      "properties": {
        "directory_generation": {
          "$ref": "#/$defs/Generation"
        },
        "expires_at_unix_ms": {
          "$ref": "#/$defs/UnixMillis"
        },
        "issued_at_unix_ms": {
          "$ref": "#/$defs/UnixMillis"
        },
        "replicas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GatewayPeerDirectoryEntry"
          },
          "maxItems": 256
        }
      },
      "additionalProperties": false,
      "required": [
        "directory_generation",
        "issued_at_unix_ms",
        "expires_at_unix_ms",
        "replicas"
      ]
    },
    "GatewayPeerDirectoryEntry": {
      "description": "Central's short-lived allow-list for authenticated Replica-to-Replica forwarding.\n\nThe mTLS CA and URI SAN establish that a peer is *a* Gateway Replica.  They do not establish\nthat the leaf is still the Registry-authoritative credential for that Replica.  Central sends\nthis directory after opening a control session and refreshes it with every accepted heartbeat;\na Gateway must reject a peer whose leaf fingerprint is absent, stale, or associated with an old\ncertificate generation.",
      "type": "object",
      "properties": {
        "certificate_fingerprint": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "certificate_generation": {
          "$ref": "#/$defs/CertificateGeneration"
        },
        "gateway_replica_id": {
          "$ref": "#/$defs/GatewayReplicaId"
        }
      },
      "additionalProperties": false,
      "required": [
        "gateway_replica_id",
        "certificate_generation",
        "certificate_fingerprint"
      ]
    },
    "GatewayPeerForwardAccepted": {
      "description": "Positive acknowledgement for one exact route generation and Agent connection.",
      "type": "object",
      "properties": {
        "agent_connection_id": {
          "$ref": "#/$defs/GatewayConnectionId"
        },
        "agent_id": {
          "$ref": "#/$defs/AgentId"
        },
        "route_generation": {
          "$ref": "#/$defs/RouteGeneration"
        },
        "session_generation": {
          "$ref": "#/$defs/SessionGeneration"
        },
        "source_replica_id": {
          "$ref": "#/$defs/GatewayReplicaId"
        },
        "target_replica_id": {
          "$ref": "#/$defs/GatewayReplicaId"
        }
      },
      "additionalProperties": false,
      "required": [
        "source_replica_id",
        "target_replica_id",
        "agent_id",
        "agent_connection_id",
        "session_generation",
        "route_generation"
      ]
    },
    "GatewayPeerForwardRequest": {
      "description": "Central-authoritative route and opaque Agent frame forwarded to the current owner Replica.\n\n`target_peer_endpoint` is copied from Central's persisted `GatewayReplica` record. A Gateway\nmust never discover alternatives, broadcast this request, or use the endpoint to change owner.",
      "type": "object",
      "properties": {
        "agent_connection_id": {
          "$ref": "#/$defs/GatewayConnectionId"
        },
        "agent_id": {
          "$ref": "#/$defs/AgentId"
        },
        "frame": {
          "description": "Exactly one LF-terminated `AgentChannelDownstreamFrame`, preserved byte-for-byte.",
          "type": "string",
          "maxLength": 1398103,
          "minLength": 4,
          "pattern": "^[A-Za-z0-9_-]*$"
        },
        "route_generation": {
          "$ref": "#/$defs/RouteGeneration"
        },
        "session_generation": {
          "$ref": "#/$defs/SessionGeneration"
        },
        "source_replica_id": {
          "$ref": "#/$defs/GatewayReplicaId"
        },
        "target_peer_endpoint": {
          "type": "string",
          "maxLength": 2048,
          "minLength": 1
        },
        "target_replica_id": {
          "$ref": "#/$defs/GatewayReplicaId"
        }
      },
      "additionalProperties": false,
      "required": [
        "source_replica_id",
        "target_replica_id",
        "target_peer_endpoint",
        "agent_id",
        "agent_connection_id",
        "session_generation",
        "route_generation",
        "frame"
      ]
    },
    "GatewayPoolId": {
      "description": "A validated gateway pool ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "GatewayReplicaHeartbeat": {
      "type": "object",
      "properties": {
        "active_streams": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "connected_agents": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "queue_depth": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "connected_agents",
        "active_streams",
        "queue_depth"
      ]
    },
    "GatewayReplicaHello": {
      "type": "object",
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "uniqueItems": true
        },
        "edge_cluster_id": {
          "$ref": "#/$defs/EdgeClusterId"
        },
        "software_version": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "supported_protocol_versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProtocolVersion"
          },
          "maxItems": 128,
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "edge_cluster_id",
        "software_version",
        "supported_protocol_versions",
        "capabilities"
      ]
    },
    "GatewayReplicaId": {
      "description": "A validated gateway replica ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "GatewayRouteFence": {
      "type": "object",
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/AgentId"
        },
        "reason": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "route_generation": {
          "$ref": "#/$defs/RouteGeneration"
        }
      },
      "additionalProperties": false,
      "required": [
        "agent_id",
        "route_generation",
        "reason"
      ]
    },
    "GatewayRouteLeaseGranted": {
      "type": "object",
      "properties": {
        "agent_connection_id": {
          "$ref": "#/$defs/GatewayConnectionId"
        },
        "agent_id": {
          "$ref": "#/$defs/AgentId"
        },
        "lease_expires_at_unix_ms": {
          "$ref": "#/$defs/UnixMillis"
        },
        "owner_replica_id": {
          "$ref": "#/$defs/GatewayReplicaId"
        },
        "replayed": {
          "type": "boolean"
        },
        "route_generation": {
          "$ref": "#/$defs/RouteGeneration"
        },
        "session_generation": {
          "$ref": "#/$defs/SessionGeneration"
        }
      },
      "additionalProperties": false,
      "required": [
        "agent_id",
        "owner_replica_id",
        "agent_connection_id",
        "session_generation",
        "route_generation",
        "lease_expires_at_unix_ms",
        "replayed"
      ]
    },
    "GatewayRouteLeaseRequest": {
      "type": "object",
      "properties": {
        "agent_connection_id": {
          "$ref": "#/$defs/GatewayConnectionId"
        },
        "agent_id": {
          "$ref": "#/$defs/AgentId"
        },
        "owner_replica_id": {
          "$ref": "#/$defs/GatewayReplicaId"
        },
        "requested_expires_at_unix_ms": {
          "$ref": "#/$defs/UnixMillis"
        },
        "route_generation": {
          "anyOf": [
            {
              "$ref": "#/$defs/RouteGeneration"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_generation": {
          "$ref": "#/$defs/SessionGeneration"
        }
      },
      "additionalProperties": false,
      "required": [
        "agent_id",
        "owner_replica_id",
        "agent_connection_id",
        "session_generation",
        "requested_expires_at_unix_ms"
      ]
    },
    "Generation": {
      "description": "A generation encoded as a canonical decimal JSON string.",
      "type": "string",
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^([1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"
    },
    "ProtocolVersion": {
      "description": "A numeric protocol revision carried in control envelopes and capability negotiation.\n\nUnlike generations and counters, protocol versions remain JSON numbers because they are small,\nclosed discriminants rather than potentially large monotonic values.",
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "RequestId": {
      "description": "A validated request ID wire identifier.",
