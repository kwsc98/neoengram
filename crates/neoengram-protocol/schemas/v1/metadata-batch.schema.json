{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MetadataProtocolSchema",
  "anyOf": [
    {
      "$ref": "#/$defs/MetadataBatchDescriptor"
    },
    {
      "$ref": "#/$defs/MetadataBatchPage"
    }
  ],
  "$defs": {
    "ArtifactId": {
      "description": "A validated artifact ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "ArtifactPlacementId": {
      "description": "A validated artifact placement ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "DecimalU64": {
      "description": "A unsigned integer encoded as a canonical decimal JSON string.",
      "type": "string",
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"
    },
    "IndexDeltaRecord": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "chunk_count": {
              "$ref": "#/$defs/DecimalU64"
            },
            "manifest_id": {
              "type": "string",
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "mutation": {
              "type": "string",
              "const": "upsert"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "total_size": {
              "$ref": "#/$defs/DecimalU64"
            }
          },
          "additionalProperties": true,
          "required": [
            "mutation",
            "path",
            "manifest_id",
            "total_size",
            "chunk_count"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mutation": {
              "type": "string",
              "const": "delete"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true,
          "required": [
            "mutation",
            "path"
          ]
        }
      ]
    },
    "IndexRevision": {
      "description": "A index revision encoded as a canonical decimal JSON string.",
      "type": "string",
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"
    },
    "JobId": {
      "description": "A validated job ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "ManifestRecord": {
      "type": "object",
      "properties": {
        "chunk_start": {
          "description": "Zero-based ordinal of the first chunk carried by this fragment.",
          "$ref": "#/$defs/DecimalU64"
        },
        "chunking": {
          "$ref": "#/$defs/WireChunkingStrategy"
        },
        "chunks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WireChunkRef"
          }
        },
        "manifest_id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "total_size": {
          "$ref": "#/$defs/DecimalU64"
        }
      },
      "additionalProperties": true,
      "required": [
        "manifest_id",
        "total_size",
        "chunking",
        "chunk_start",
        "chunks"
      ]
    },
    "MetadataBatchDescriptor": {
      "description": "Immutable declaration uploaded before any page is accepted into staging.",
      "type": "object",
      "properties": {
        "batch_digest": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "batch_id": {
          "$ref": "#/$defs/MetadataBatchId"
        },
        "encoded_bytes": {
          "description": "Sum of the canonical JSON byte lengths declared by `pages`.",
          "$ref": "#/$defs/DecimalU64"
        },
        "kind": {
          "$ref": "#/$defs/MetadataBatchKind"
        },
        "page_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MetadataPageDescriptor"
          }
        },
        "record_count": {
          "$ref": "#/$defs/DecimalU64"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint16",
          "const": 1,
          "maximum": 65535,
          "minimum": 0
        },
        "scope": {
          "$ref": "#/$defs/MetadataBatchScope"
        }
      },
      "additionalProperties": true,
      "required": [
        "batch_id",
        "scope",
        "kind",
        "schema_version",
        "page_count",
        "record_count",
        "encoded_bytes",
        "pages",
        "batch_digest"
      ]
    },
    "MetadataBatchId": {
      "description": "A validated metadata batch ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "MetadataBatchKind": {
      "type": "string",
      "enum": [
        "manifest",
        "index_delta",
        "object_receipt"
      ]
    },
    "MetadataBatchPage": {
      "description": "One independently verified metadata page.",
      "type": "object",
      "properties": {
        "batch_id": {
          "$ref": "#/$defs/MetadataBatchId"
        },
        "page_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "page_digest": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "page_number": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "schema_version": {
          "type": "integer",
          "format": "uint16",
          "const": 1,
          "maximum": 65535,
          "minimum": 0
        },
        "scope": {
          "$ref": "#/$defs/MetadataBatchScope"
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "manifest"
            },
            "records": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ManifestRecord"
              },
              "maxItems": 4096
            }
          },
          "required": [
            "kind",
            "records"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "index_delta"
            },
            "records": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/IndexDeltaRecord"
              },
              "maxItems": 4096
            }
          },
          "required": [
            "kind",
            "records"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "object_receipt"
            },
            "records": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ObjectReceiptRecord"
              },
              "maxItems": 4096
            }
          },
          "required": [
            "kind",
            "records"
          ]
        }
      ],
      "required": [
        "batch_id",
        "scope",
        "schema_version",
        "page_number",
        "page_count",
        "page_digest"
      ],
      "unevaluatedProperties": true
    },
    "MetadataBatchScope": {
      "description": "Full authority and CAS scope shared by a descriptor and every page in its batch.",
      "type": "object",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "base_index_version": {
          "$ref": "#/$defs/WireIndexVersion"
        },
        "job_id": {
          "$ref": "#/$defs/JobId"
        },
        "playground_id": {
          "$ref": "#/$defs/PlaygroundId"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "tenant_id": {
          "$ref": "#/$defs/TenantId"
        }
      },
      "additionalProperties": true,
      "required": [
        "tenant_id",
        "project_id",
        "artifact_id",
        "playground_id",
        "job_id",
        "base_index_version"
      ]
    },
    "MetadataPageDescriptor": {
      "description": "Ordered integrity entry for one page. `encoded_bytes` is the RFC 8785 JCS byte length.",
      "type": "object",
      "properties": {
        "encoded_bytes": {
          "description": "Byte length of this page's complete RFC 8785 canonical JSON representation.",
          "$ref": "#/$defs/DecimalU64"
        },
        "page_digest": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "page_number": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "record_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": true,
      "required": [
        "page_number",
        "record_count",
        "encoded_bytes",
        "page_digest"
      ]
    },
    "ObjectReceiptId": {
      "description": "A validated object receipt ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "ObjectReceiptRecord": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "artifact_placement_id": {
          "$ref": "#/$defs/ArtifactPlacementId"
        },
        "job_id": {
          "$ref": "#/$defs/JobId"
        },
        "object_id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "receipt_id": {
          "$ref": "#/$defs/ObjectReceiptId"
        },
        "size": {
          "$ref": "#/$defs/DecimalU64"
        },
        "storage_volume_id": {
          "$ref": "#/$defs/StorageVolumeId"
        },
        "tenant_id": {
          "$ref": "#/$defs/TenantId"
        },
        "verified_at_unix_ms": {
          "$ref": "#/$defs/UnixMillis"
        }
      },
      "additionalProperties": true,
      "required": [
        "receipt_id",
        "tenant_id",
        "artifact_id",
        "job_id",
        "storage_volume_id",
        "artifact_placement_id",
        "object_id",
        "size",
        "verified_at_unix_ms"
      ]
    },
    "PlaygroundId": {
      "description": "A validated playground ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "ProjectId": {
      "description": "A validated project ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "StorageVolumeId": {
      "description": "A validated storage volume ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "TenantId": {
      "description": "A validated tenant ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "UnixMillis": {
      "description": "A Unix millisecond timestamp encoded as a canonical decimal JSON string.",
      "type": "string",
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"
    },
    "WireChunkRef": {
      "type": "object",
      "properties": {
        "object_id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "offset": {
          "$ref": "#/$defs/DecimalU64"
        },
        "size": {
          "$ref": "#/$defs/DecimalU64"
        }
      },
      "additionalProperties": true,
      "required": [
        "object_id",
        "offset",
        "size"
      ]
    },
    "WireChunkingStrategy": {
      "type": "string",
      "enum": [
        "fast_cdc",
        "whole_file"
      ]
    },
    "WireIndexVersion": {
      "description": "An IndexVersion adapted to the wire's decimal-string integer rule.",
      "type": "object",
      "properties": {
        "digest": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "revision": {
          "$ref": "#/$defs/IndexRevision"
        }
      },
      "additionalProperties": true,
      "required": [
        "revision",
        "digest"
      ]
    }
  }
}
