    "LeaseId": {
      "description": "A validated lease ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "LeaseMode": {
      "type": "string",
      "enum": [
        "shared_read",
        "exclusive_write"
      ]
    },
    "MessageId": {
      "description": "A validated message ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "MetadataBatchDescriptor": {
      "description": "Immutable declaration uploaded before any page is accepted into staging.",
      "type": "object",
      "properties": {
        "batch_digest": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "batch_id": {
          "$ref": "#/$defs/MetadataBatchId"
        },
        "encoded_bytes": {
          "description": "Sum of the canonical JSON byte lengths declared by `pages`.",
          "$ref": "#/$defs/DecimalU64"
        },
        "kind": {
          "$ref": "#/$defs/MetadataBatchKind"
        },
        "page_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MetadataPageDescriptor"
          }
        },
        "record_count": {
          "$ref": "#/$defs/DecimalU64"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint16",
          "const": 1,
          "maximum": 65535,
          "minimum": 0
        },
        "scope": {
          "$ref": "#/$defs/MetadataBatchScope"
        }
      },
      "additionalProperties": true,
      "required": [
        "batch_id",
        "scope",
        "kind",
        "schema_version",
        "page_count",
        "record_count",
        "encoded_bytes",
        "pages",
        "batch_digest"
      ]
    },
    "MetadataBatchId": {
      "description": "A validated metadata batch ID wire identifier.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,127})$"
    },
    "MetadataBatchKind": {
      "type": "string",
      "enum": [
        "manifest",
        "index_delta",
        "object_receipt"
      ]
    },
    "MetadataBatchScope": {
      "description": "Full authority and CAS scope shared by a descriptor and every page in its batch.",
      "type": "object",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "base_index_version": {
          "$ref": "#/$defs/WireIndexVersion"
        },
        "job_id": {
          "$ref": "#/$defs/JobId"
        },
        "playground_id": {
          "$ref": "#/$defs/PlaygroundId"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "tenant_id": {
          "$ref": "#/$defs/TenantId"
        }
      },
      "additionalProperties": true,
      "required": [
        "tenant_id",
        "project_id",
        "artifact_id",
        "playground_id",
        "job_id",
        "base_index_version"
      ]
    },
    "MetadataPageDescriptor": {
      "description": "Ordered integrity entry for one page. `encoded_bytes` is the RFC 8785 JCS byte length.",
      "type": "object",
      "properties": {
        "encoded_bytes": {
          "description": "Byte length of this page's complete RFC 8785 canonical JSON representation.",
          "$ref": "#/$defs/DecimalU64"
        },
        "page_digest": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "page_number": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "record_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": true,
      "required": [
        "page_number",
        "record_count",
        "encoded_bytes",
        "page_digest"
      ]
    },
    "MountAccessMode": {
      "type": "string",
      "enum": [
        "read_only",
        "read_write"
      ]
    },
    "MountGeneration": {
      "description": "A mount generation encoded as a canonical decimal JSON string.",
      "type": "string",
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^([1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"
    },
