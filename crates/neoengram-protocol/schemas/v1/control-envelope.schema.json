    "WireIndexVersion": {
      "description": "An IndexVersion adapted to the wire's decimal-string integer rule.",
      "type": "object",
      "properties": {
        "digest": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
