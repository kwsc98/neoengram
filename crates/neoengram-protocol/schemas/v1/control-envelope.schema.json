            "published_index_version"
          ]
        },
        {
          "type": "object",
          "properties": {
            "current_index_version": {
              "$ref": "#/$defs/WireIndexVersion"
            },
            "outcome": {
              "type": "string",
              "const": "conflict"
            }
          },
          "additionalProperties": true,
          "required": [
            "outcome",
            "current_index_version"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "$ref": "#/$defs/ControlError"
            },
            "outcome": {
