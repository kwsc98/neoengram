VITE_API_MODE=real
VITE_API_BASE_URL=
# The Web console emits Agent YAML for this one GatewayPool/EdgeCluster.
# Keep the binding empty only for the loopback development profile.
VITE_GATEWAY_ENDPOINT=http://127.0.0.1:8181
# S3 path-style endpoint exposed by the Gateway public listener.
VITE_S3_ENDPOINT=http://127.0.0.1:8084
VITE_GATEWAY_EDGE_CLUSTER_ID=
VITE_GATEWAY_WORKLOAD_TRUST_DOMAIN=

# Local loopback development profile. Production builds reject this mode.
VITE_AUTH_MODE=development
VITE_DEVELOPMENT_TOKEN=local-development-token
VITE_DEVELOPMENT_PRINCIPAL=development-user

# Production profile:
# VITE_AUTH_MODE=oidc
VITE_OIDC_AUTHORITY=https://identity.example.com
VITE_OIDC_CLIENT_ID=neoengram-web
VITE_OIDC_SCOPE=openid profile
