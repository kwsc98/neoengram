{
  "name": "@neoengram/web",
  "version": "0.2.0",
  "private": true,
  "description": "NeoEngram public web console",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "overrides": {
    "@redocly/openapi-core": {
      "js-yaml": "4.3.0"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc -b --force",
    "api:generate": "openapi-typescript ../../docs/openapi/neoengram-api.yaml -o src/api/generated/openapi.d.ts",
    "api:check": "openapi-typescript ../../docs/openapi/neoengram-api.yaml -o src/api/generated/openapi.d.ts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@tanstack/vue-query": "5.101.4",
    "element-plus": "2.14.3",
    "js-yaml": "^4.3.0",
    "oidc-client-ts": "3.5.0",
    "openapi-fetch": "0.17.0",
    "pinia": "4.0.2",
    "vue": "3.5.40",
    "vue-router": "4.6.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/vue": "6.6.1",
    "@tsconfig/node22": "22.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "22.12.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "2.2.7",
    "@vue/tsconfig": "0.9.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.6.2",
    "jsdom": "26.1.0",
    "msw": "2.12.4",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue-eslint-parser": "10.2.0",
    "vue-tsc": "3.3.8"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "msw@2.12.4": true
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
