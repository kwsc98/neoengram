{
  "name": "@neoengram/openapi",
  "version": "1.0.0",
  "private": true,
  "description": "Linting and bundling for the NeoEngram public OpenAPI contract",
  "scripts": {
    "lint": "redocly lint --config redocly.yaml neoengram-api.yaml",
    "bundle": "mkdir -p ../../target/openapi && redocly bundle --config redocly.yaml neoengram-api.yaml --output ../../target/openapi/neoengram-api.json",
    "test:contract": "node scripts/check-contract.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "2.41.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  }
}
